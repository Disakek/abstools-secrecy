module AssignExamples;

class AssignExamples {

    [Secrecy: High] Int high = 20;

    [Secrecy: High] Int otherHigh = 203;

    [Secrecy: Low] Int low = 3;

    [Secrecy: Low] Int c = 2;

    //meant to pass
    Unit secure_assign_low_to_low_under_low() {
        low = c;
    }

    //meant to fail | Assignment =>
    // low:Low = high:High is possibly leaking
    Unit secure_assign_high_to_low_under_low() {
        low = high;
    }

    //meant to pass
    Unit secure_assign_low_to_high_under_low() {
        high = low;
    }

    //meant to pass
    Unit secure_assign_high_to_high_under_low() {
        high = otherHigh;
    }

    //And below ones that only lead to an error for flow-insensitive analysis

    // meant to fail for flow-insensitive | Assignment =>
    // low:"Low" = high:"High" is possibly leaking
    // flow-sensitive => sees high = 7 sets high:"Low" and allows low:"Low" = high:"Low"
    Unit insecure_only_for_flow_insensitive() {
        high = 7;
        low = high;
    }

}