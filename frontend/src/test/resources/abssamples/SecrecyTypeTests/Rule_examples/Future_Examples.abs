module FutureExamples;

class FutureExamples {

    [Secrecy: High] Int highVariable = 8;
    [Secrecy: Low] Int lowVariable = 0;
    [Secrecy: Low] Int otherLow = 0;

    Int futureExampleMethodCallingLowReturn() {
        Fut<Int> someFuture = this!lowReturnHelperMethod();

        lowVariable = highVariable;
        await someFuture?;
        lowVariable = otherLow;

        Int result = someFuture.get;

        return  result;
    }

    Int futureExampleMethodCallingHighReturLowFuture() {
        Fut<Int> someFuture = this!highReturnHelperMethod();

        lowVariable = highVariable;
        await someFuture?;
        lowVariable = otherLow;

        Int result = someFuture.get;

        return  result;
    }

    [Secrecy: High] Int futureExampleMethodCallingLowReturHighFuture() {
        [Secrecy: High] Fut<Int> someFuture = this!lowReturnHelperMethod();

        lowVariable = highVariable;
        await someFuture?;
        lowVariable = otherLow;

        [Secrecy: High] Int result = someFuture.get;

        return  result;
    }

    [Secrecy: High] Int futureExampleMethodCallingHighReturHighFuture() {
        [Secrecy: High] Fut<Int> someFuture = this!highReturnHelperMethod();

        lowVariable = highVariable;
        await someFuture?;
        lowVariable = otherLow;

        [Secrecy: High] Int result = someFuture.get;

        return  result;
    }

    Int lowReturnHelperMethod() {
        return 8;
    }

    [Secrecy: High] Int highReturnHelperMethod() {
        return 8;
    }
}