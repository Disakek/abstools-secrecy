import org.abs_models.frontend.typechecker.ext.secrecytype.*;

/**
 * Used to handover the user input for the --flow-insensitive option to the SecrecyAnnotationChecker.
 * Default case is false meaning we usually use a flow-sensitive approach.
 *
 * @author Maximilian Paul
 */
aspect Boolean {
    public Boolean Model.flowInsensitiveFlag;
}
