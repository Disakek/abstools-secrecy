import org.abs_models.frontend.typechecker.ext.secrecytype.*;

/**
 * Used to handover the user input for the --secrecy option to the SecrecyAnnotationChecker.
 * Default case is a secrecy lattice defined by "Low < High".
 *
 * @author Maximilian Paul
 */
aspect SecrecyAnnotationLattice {
    public SecrecyLatticeStructure Model.secrecyLatticeStructure = null;
}
